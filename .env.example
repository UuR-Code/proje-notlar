# Environment variables example
# SQLite (varsayılan, sıfır yapılandırma ile anında çalışır)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Coolify / VPS / Docker dağıtımları için)
# DATABASE_URL="postgresql://user:password@host:5432/proje_notlar?schema=public"

# Güvenli JWT oturum anahtarı (üretimde rastgele uzun bir dize girin)
JWT_SECRET="proje-notlar-ultra-secret-jwt-key-change-this-in-production"

# Kasa şifreleme anahtarı (AES-256 için 32 karakter dize)
VAULT_SECRET_KEY="proje-notlar-kasa-sifresi-32byte"

# Uygulama URL'si
NEXT_PUBLIC_APP_URL="http://localhost:3000"
