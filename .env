# Environment variables
# For SQLite (default, zero setup needed):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (e.g. in Coolify / Docker / VPS):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/proje_notlar?schema=public"

# Session JWT secret (change in production)
JWT_SECRET="proje-notlar-ultra-secret-jwt-key-2026-production"

# Secret key for Vault AES-256-GCM encryption (must be 32 bytes string)
VAULT_SECRET_KEY="proje-notlar-kasa-sifresi-32byte"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
